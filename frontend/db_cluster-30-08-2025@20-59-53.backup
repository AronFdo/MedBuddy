--
-- Name: appointments Access own appointments; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Access own appointments" ON public.appointments USING ((auth.uid() = ( SELECT profiles.user_id
   FROM public.profiles
  WHERE (profiles.id = appointments.profile_id))));


--
-- Name: conversations Access own conversations; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Access own conversations" ON public.conversations USING ((auth.uid() = ( SELECT profiles.user_id
   FROM public.profiles
  WHERE (profiles.id = conversations.profile_id))));


--
-- Name: medication_logs Access own medication logs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Access own medication logs" ON public.medication_logs USING ((auth.uid() = ( SELECT profiles.user_id
   FROM public.profiles
  WHERE (profiles.id = medication_logs.profile_id))));


--
-- Name: prescriptions Access own prescriptions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Access own prescriptions" ON public.prescriptions USING ((auth.uid() = ( SELECT profiles.user_id
   FROM public.profiles
  WHERE (profiles.id = prescriptions.profile_id))));


--
-- Name: health_records Access own records; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Access own records" ON public.health_records USING ((auth.uid() = ( SELECT profiles.user_id
   FROM public.profiles
  WHERE (profiles.id = health_records.profile_id))));


--
-- Name: profiles Owner can access their own profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Owner can access their own profiles" ON public.profiles USING ((auth.uid() = user_id));


--
-- Name: ai_conversations Service role can delete ai_conversations; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can delete ai_conversations" ON public.ai_conversations FOR DELETE USING (((auth.role() = 'service_role'::text) OR (profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))));


--
-- Name: ai_conversations Service role can insert ai_conversations; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can insert ai_conversations" ON public.ai_conversations FOR INSERT WITH CHECK (((auth.role() = 'service_role'::text) OR (profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))));


--
-- Name: ai_conversations Service role can read ai_conversations by profile_id; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can read ai_conversations by profile_id" ON public.ai_conversations FOR SELECT USING (((auth.role() = 'service_role'::text) OR (profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))));


--
-- Name: appointments Service role can read appointments by profile_id; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can read appointments by profile_id" ON public.appointments FOR SELECT USING (((auth.role() = 'service_role'::text) OR (profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))));


--
-- Name: health_records Service role can read health_records by profile_id; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can read health_records by profile_id" ON public.health_records FOR SELECT USING (((auth.role() = 'service_role'::text) OR (profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))));


--
-- Name: medications Service role can read medications by profile_id; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can read medications by profile_id" ON public.medications FOR SELECT USING (((auth.role() = 'service_role'::text) OR (profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))));


--
-- Name: medications Users can delete medications for their profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can delete medications for their profiles" ON public.medications FOR DELETE USING ((profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid()))));


--
-- Name: medications Users can insert medications for their own profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can insert medications for their own profiles" ON public.medications FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = medications.profile_id) AND (profiles.user_id = auth.uid())))));


--
-- Name: medications Users can insert medications for their profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can insert medications for their profiles" ON public.medications FOR INSERT WITH CHECK ((profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid()))));


--
-- Name: medications Users can update medications for their profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can update medications for their profiles" ON public.medications FOR UPDATE USING ((profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid())))) WITH CHECK ((profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid()))));


--
-- Name: medications Users can view medications for their profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view medications for their profiles" ON public.medications FOR SELECT USING ((profile_id IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.user_id = auth.uid()))));


