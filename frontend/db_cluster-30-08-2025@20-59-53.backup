--
-- Name: objects Allow authenticated users to create signed URLs; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow authenticated users to create signed URLs" ON storage.objects FOR SELECT TO authenticated USING (((bucket_id = 'reports'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.health_records
  WHERE ((health_records.attachment_url = objects.name) AND (health_records.profile_id IN ( SELECT profiles.id
           FROM public.profiles
          WHERE (profiles.user_id = auth.uid()))))))));


--
-- Name: objects Allow authenticated users to upload profile pic jh40r1_0; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow authenticated users to upload profile pic jh40r1_0" ON storage.objects FOR UPDATE TO authenticated USING ((bucket_id = 'profile-pics'::text));


--
-- Name: objects Allow authenticated users to upload reports for their profiles; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow authenticated users to upload reports for their profiles" ON storage.objects FOR INSERT TO authenticated WITH CHECK (((bucket_id = 'reports'::text) AND (auth.uid() IS NOT NULL)));


--
-- Name: objects Allow public access to profile pictures jh40r1_0; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow public access to profile pictures jh40r1_0" ON storage.objects FOR SELECT TO authenticated USING ((bucket_id = 'profile-pics'::text));


--
-- Name: objects Allow users to delete profile picture jh40r1_0; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow users to delete profile picture jh40r1_0" ON storage.objects FOR DELETE TO authenticated USING ((bucket_id = 'profile-pics'::text));


--
-- Name: objects Allow users to delete reports for their profiles; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow users to delete reports for their profiles" ON storage.objects FOR DELETE TO authenticated USING (((bucket_id = 'reports'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.health_records
  WHERE (((health_records.id)::text = (storage.foldername(objects.name))[2]) AND (health_records.profile_id IN ( SELECT profiles.id
           FROM public.profiles
          WHERE (profiles.user_id = auth.uid()))))))));


--
-- Name: objects Allow users to update reports for their profiles; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow users to update reports for their profiles" ON storage.objects FOR UPDATE TO authenticated USING (((bucket_id = 'reports'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.health_records
  WHERE (((health_records.id)::text = (storage.foldername(objects.name))[2]) AND (health_records.profile_id IN ( SELECT profiles.id
           FROM public.profiles
          WHERE (profiles.user_id = auth.uid())))))))) WITH CHECK (((bucket_id = 'reports'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.health_records
  WHERE (((health_records.id)::text = (storage.foldername(objects.name))[2]) AND (health_records.profile_id IN ( SELECT profiles.id
           FROM public.profiles
          WHERE (profiles.user_id = auth.uid()))))))));


--
-- Name: objects Allow users to upload profile picture jh40r1_0; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow users to upload profile picture jh40r1_0" ON storage.objects FOR INSERT TO authenticated WITH CHECK ((bucket_id = 'profile-pics'::text));


--
-- Name: objects Allow users to view reports for their profiles; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Allow users to view reports for their profiles" ON storage.objects FOR SELECT TO authenticated USING (((bucket_id = 'reports'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.health_records
  WHERE (((health_records.id)::text = (storage.foldername(objects.name))[2]) AND (health_records.profile_id IN ( SELECT profiles.id
           FROM public.profiles
          WHERE (profiles.user_id = auth.uid()))))))));


